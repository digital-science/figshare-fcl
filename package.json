{
  "type": "module",
  "name": "@digital-science/figshare-fcl-documentation",
  "description": "Figshare components library (FCL) for research repositories",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "1.6.8",
  "main": "index.js",
  "private": true,
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "lint:js": "eslint ./",
    "lint:staged": "lint-staged",
    "lint:js:fix": "eslint ./ --fix",
    "test": "jest",
    "test:generateJSON": "jest --json --outputFile=.jest-results.json || true",
    "storybook": "NODE_ENV=development storybook dev -p 9001",
    "storybook:build": "NODE_ENV=production storybook build -o build",
    "test:storybook": "vitest run"
  },
  "pre-commit": {
    "run": [
      "lint:staged"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint"
    ],
    "*.css": [
      "stylelint"
    ]
  },
  "overrides": {
    "form-data": "4.0.6",
    "immutable": "3.8.3",
    "node-fetch": "2.6.7",
    "handlebars": "4.7.9",
    "tar": "7.5.16",
    "minimatch": "3.1.3",
    "braces": "3.0.3",
    "aria-query": "5.3.2",
    "draft-js": {
      "immutable": "3.8.3",
      "node-fetch": "2.6.7"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-science/figshare-fcl.git"
  },
  "keywords": [
    "figshare",
    "frontend",
    "fcl",
    "core",
    "commons"
  ],
  "author": "Digital Science",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/digital-science/figshare-fcl/issues"
  },
  "homepage": "https://github.com/digital-science/figshare-fcl#readme",
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/eslint-parser": "7.16.5",
    "@babel/eslint-plugin": "7.16.5",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "7.18.6",
    "@digital-science/figshare-style-guide": "4.0.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-jest": "29.7.0",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "identity-obj-proxy": "3.0.0",
    "immutable": "3.8.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "15.2.0",
    "moment": "2.29.4",
    "playwright": "1.62.1",
    "pre-commit": "1.2.2",
    "prop-types": "15.8.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "storybook": "10.5.10",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@digital-science/figshare-fcl": "file:./packages/ui",
    "core-js": "3.26.1",
    "regenerator-runtime": "0.13.11"
  }
}
